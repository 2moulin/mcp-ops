{
  "name": "mcp-ops",
  "version": "0.3.1",
  "description": "One read-only MCP server that gives your AI agent eyes on your whole production stack: Stripe Connect, Postgres, Neon, Vercel, Netlify, Render, Cloudflare, Resend, Postmark, Twilio, Sentry, Better Stack, Shopify, GitHub. Status in one call, a cross-service timeline, and diagnostics that explain why things fail.",
  "type": "module",
  "bin": {
    "mcp-ops": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "cursor",
    "ai-agents",
    "devops",
    "observability",
    "read-only",
    "stripe",
    "stripe-connect",
    "postgres",
    "neon",
    "vercel",
    "netlify",
    "render",
    "cloudflare",
    "resend",
    "postmark",
    "twilio",
    "sentry",
    "betterstack",
    "shopify",
    "github"
  ],
  "author": "David Demoulin (https://github.com/2moulin)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/2moulin/mcp-ops"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
